# ---------- obrigatórias ----------
# Postgres do EasyPanel (serviço separado, NÃO o da Águia Diesel)
DATABASE_URL=postgres://credweb:SENHA@credweb_db:5432/credweb

# E-mails que acessam a tela de Administração (separados por vírgula)
SUPERADMIN_EMAILS=

# ---------- fontes públicas (chaves PRÓPRIAS do credweb) ----------
# Sem a chave, a fonte aparece como "não verificado" e vale metade dos pontos.
PORTAL_TRANSPARENCIA_CHAVE=     # grátis: portaldatransparencia.gov.br/api-de-dados/cadastrar-email
GOOGLE_MAPS_API_KEY=            # Places API (New)
CNPJA_API_KEY=                  # plano grátis do CNPJá
TAVILY_API_KEY=                 # 1.000 buscas/mês grátis (4 por análise)

# ---------- opcionais ----------
# PLANO_TESTE_DIAS=14
# PLANO_TESTE_ANALISES=10
# CACHE_PUBLICO_DIAS=7          # 0 desliga o cache de Receita e pesquisa
# CADASTRO_ABERTO=true          # false fecha o cadastro de novas empresas
# COOKIE_SEGURO=true            # false só para testar sem HTTPS
# LOG_LEVEL=info
